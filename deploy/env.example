# 写入 ~/.hermes/.env（权限 600）。由 setup-webapp.sh 自动生成；这里只是格式示例，不含真实值。
# 不要把明文密码写进来；只写 scrypt 哈希：
#   echo -n '你的密码' | (cd ~/.hermes/hermes-agent && ./scripts/run-in-hermes-env python -c \
#     'import sys; from plugins.dashboard_auth.basic import hash_password; print(hash_password(sys.stdin.read()))')
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=me
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$16384$8$1$<salt-base64>$<hash-base64>
HERMES_DASHBOARD_BASIC_AUTH_SECRET=<32 字节以上随机串，用于签名登录 Cookie；修改后所有设备需重新登录>
# 可选：登录有效期（秒），默认 43200（12 小时，期间自动续期最长 30 天）
# HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=43200
